# Copy to .env and fill in your key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ports
GAME_PORT=8000
LOBBY_PORT=8100
# Optional hostname shown to players instead of an auto-detected LAN IP.
# It must already resolve to this computer, for example: arena.home
LOBBY_PUBLIC_HOST=

# Shared secret used for the internal game <-> lobby calls.
ARENA_INTERNAL_TOKEN=change-me-local-dev

# Match settings
STOCKS=3
